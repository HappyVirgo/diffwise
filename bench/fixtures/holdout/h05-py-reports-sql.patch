+import logging
+import sqlite3
+
+log = logging.getLogger(__name__)
+
+
+def revenue_by_region(conn: sqlite3.Connection, region: str):
+    query = f"SELECT SUM(total) FROM orders WHERE region = '{region}'"
+    print(query)
+    return conn.execute(query).fetchone()[0]
+
+
+def top_customers(conn, limit, since):
+    sql = "SELECT customer_id FROM orders WHERE created_at >= '%s' LIMIT %d" % (since, limit)
+    return conn.execute(sql).fetchall()
+
+
+def orders_for_customer(conn, customer_id):
+    return conn.execute(
+        "SELECT id, total FROM orders WHERE customer_id = ?", (customer_id,)
+    ).fetchall()
+
+
+def delete_region(conn, region):
+    conn.execute("DELETE FROM orders WHERE region = '{}'".format(region))
+
+
+def safe_count(conn):
+    try:
+        return conn.execute("SELECT COUNT(*) FROM orders").fetchone()[0]
+    except sqlite3.OperationalError:
+        pass
+    # XXX: callers expect None when the table is missing
+    return None
+
+
+def debug_dump(conn):
+    breakpoint()
+    log.info("dumped %d rows", conn.total_changes)
