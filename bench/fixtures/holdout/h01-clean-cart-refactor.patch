+export type DiscountCode = { kind: "percent" | "fixed"; amount: number };
+
+// Codes are applied in order; percentage codes stack multiplicatively.
+export function applyDiscounts(subtotal: number, codes: DiscountCode[]): number {
+  let total = subtotal;
+  for (const code of codes) {
+    if (code.kind === "percent") {
+      total = total * (1 - code.amount / 100);
+    } else {
+      total = total - code.amount;
+    }
+  }
+  return Math.max(0, Math.round(total * 100) / 100);
+}
